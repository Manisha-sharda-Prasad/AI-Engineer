# Render environment-variable reference for render-microservices.yaml.
# Configure each section on the matching Render service. Variables repeated
# between sections must be configured independently on each service.
# Never commit real credentials or service-account JSON to this file.

# ================================================================
# 1. Gateway: youtube-learning-gateway
# ================================================================
PYTHON_VERSION=3.11.11
FRONTEND_URL=https://youtube-learning-ui.onrender.com
GATEWAY_YOUTUBE_SERVICE_URL=https://youtube-learning-youtube.onrender.com
GATEWAY_PLANS_SERVICE_URL=https://youtube-learning-plans.onrender.com
FIREBASE_PROJECT_ID=<firebase-project-id>
FIREBASE_SERVICE_ACCOUNT_JSON=<single-line-firebase-service-account-json>

# ================================================================
# 2. YouTube service: youtube-learning-youtube
# ================================================================
PYTHON_VERSION=3.11.11
STORAGE_BACKEND=postgres
DATABASE_URL=<postgres-connection-string>
FIREBASE_PROJECT_ID=<firebase-project-id>
FIREBASE_SERVICE_ACCOUNT_JSON=<single-line-firebase-service-account-json>
INTERNAL_SERVICE_TOKEN=<shared-plans-youtube-service-token>
FRONTEND_URL=https://youtube-learning-ui.onrender.com
GOOGLE_CLIENT_ID=<google-oauth-client-id>
GOOGLE_CLIENT_SECRET=<google-oauth-client-secret>
GOOGLE_REDIRECT_URI=https://youtube-learning-gateway.onrender.com/auth/google/callback
# Generated automatically by Render when the Blueprint first creates the service.
YOUTUBE_OAUTH_STATE_SECRET=<render-generated-secret>
YOUTUBE_TOKEN_ENCRYPTION_KEY=<stable-fernet-key>

# ================================================================
# 3. Plans service: youtube-learning-plans
# ================================================================
PYTHON_VERSION=3.11.11
STORAGE_BACKEND=postgres
DATABASE_URL=<postgres-connection-string>
FIREBASE_PROJECT_ID=<firebase-project-id>
FIREBASE_SERVICE_ACCOUNT_JSON=<single-line-firebase-service-account-json>
INTERNAL_SERVICE_TOKEN=<shared-plans-youtube-service-token>
YOUTUBE_SERVICE_URL=https://youtube-learning-youtube.onrender.com
FRONTEND_URL=https://youtube-learning-ui.onrender.com
GROQ_API_KEY=<groq-api-key>
GOOGLE_API_KEY=<google-ai-api-key>
OPENAI_API_KEY=<openai-api-key>

# ================================================================
# 4. Static UI: youtube-learning-ui
# ================================================================
NODE_VERSION=20.19.0
VITE_API_BASE_URL=https://youtube-learning-gateway.onrender.com
VITE_FIREBASE_API_KEY=<firebase-web-api-key>
VITE_FIREBASE_AUTH_DOMAIN=<firebase-project-id>.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=<firebase-project-id>
VITE_FIREBASE_APP_ID=<firebase-web-app-id>
VITE_GOOGLE_CLIENT_ID=<google-oauth-client-id>
VITE_ENABLE_AI="true"
